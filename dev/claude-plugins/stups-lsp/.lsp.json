{
  "typescript": {
    "command": "node",
    "args": ["${CLAUDE_PROJECT_DIR}/node_modules/typescript-language-server/lib/cli.mjs", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".mts": "typescript",
      ".js": "javascript",
      ".mjs": "javascript"
    },
    "initializationOptions": {
      "tsserver": { "useSyntaxServer": "never" },
      "plugins": [{ "name": "typescript-svelte-plugin", "location": "." }]
    }
  },
  "svelte": {
    "command": "node",
    "args": ["${CLAUDE_PROJECT_DIR}/node_modules/svelte-language-server/bin/server.js", "--stdio"],
    "extensionToLanguage": {
      ".svelte": "svelte"
    }
  }
}
